---
// Layout für einen Blog-Post: SEO-Head (Title/Description/Canonical/OG/JSON-LD),
// schlanke Typografie, danach Feedback-Widget + Kommentare (dynamisch, SEO-neutral).
import Comments from '../components/Comments.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
}
const { title, description, date, tags, slug } = Astro.props;
const canonical = `https://heimvio.de/blog/${slug}`;
const dateIso = date.toISOString().slice(0, 10);
const dateHuman = date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: dateIso,
  inLanguage: 'de-DE',
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: 'Heimvio' },
});
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Heimvio Blog</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Heimvio Blog" href="/blog/rss.xml" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" type="image/svg+xml" href="/blog/favicon.svg" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <SiteHeader />
    <main>
      <article>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={dateIso}>{dateHuman}</time>
          {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>}
        </p>
        <slot />
      </article>
      <FeedbackWidget slug={slug} />
      <Comments slug={slug} />
    </main>
    <footer class="site">
      <p>
        <a href="/blog/">Blog</a> · <a href="/blog/rss.xml">RSS</a> ·
        <a href="https://heimvio.de/">heimvio.de</a> ·
        <a href="https://heimvio.de/impressum">Impressum</a> ·
        <a href="https://heimvio.de/datenschutz">Datenschutz</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root { --fg: #1c2733; --muted: #5b6b7b; --border: #dde4ea; --accent: #1976d2; --bg: #ffffff; --surface: #f5f7f9; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e4e9ee; --muted: #93a3b3; --border: #2e3b47; --accent: #64a9e8; --bg: #10161c; --surface: #1a222b; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.65 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 44rem; margin: 0 auto; padding: 0 1.25rem 3rem; }
  header.site, footer.site { max-width: 44rem; margin: 0 auto; padding: 1rem 1.25rem; font-size: .9rem; }
  footer.site { border-top: 1px solid var(--border); margin-top: 2rem; color: var(--muted); }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1 { font-size: 1.9rem; line-height: 1.25; margin: 1rem 0 .25rem; }
  h2 { font-size: 1.35rem; margin-top: 2rem; }
  h3 { font-size: 1.1rem; }
  .meta { color: var(--muted); font-size: .9rem; display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; }
  .tag { background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: .05rem .6rem; margin-right: .35rem; font-size: .8rem; }
  article img { max-width: 100%; height: auto; border-radius: 8px; }
  blockquote { border-left: 3px solid var(--border); margin: 1rem 0; padding: .25rem 1rem; color: var(--muted); }
  code { background: var(--surface); border-radius: 4px; padding: .1rem .35rem; font-size: .9em; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border: 1px solid var(--border); padding: .4rem .6rem; text-align: left; }
</style>
