---
// Layout für einen Blog-Post: Artikel-Meta (Datum/Tags), danach Feedback-Widget +
// Kommentare (dynamisch, SEO-neutral). Head/Header/Footer/Styles kommen aus BaseLayout.
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
}
const { title, description, date, tags, slug } = Astro.props;
const canonical = `https://heimvio.de/blog/${slug}`;
const dateIso = date.toISOString().slice(0, 10);
const dateHuman = date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: dateIso,
  inLanguage: 'de-DE',
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: 'Heimvio' },
});
---

<BaseLayout
  title={`${title} · Heimvio Blog`}
  description={description}
  canonical={canonical}
  section="blog"
  ogType="article"
  jsonLd={jsonLd}
>
  <main>
    <article>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={dateIso}>{dateHuman}</time>
        {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>}
      </p>
      <slot />
    </article>
    <FeedbackWidget slug={slug} />
    <Comments slug={slug} />
  </main>

  <!-- Aufrufzähler: reines Tagesaggregat serverseitig (keine IP/Cookies) — sendBeacon
       blockiert das Rendering nicht und feuert auch bei schnellem Weiternavigieren. -->
  <script define:vars={{ slug }}>
    try { navigator.sendBeacon(`/api/comments/${encodeURIComponent(slug)}/view`); } catch { /* optional */ }
  </script>
</BaseLayout>

<style>
  .meta { color: var(--muted); font-size: .9rem; display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; }
  .tag { background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: .05rem .6rem; margin-right: .35rem; font-size: .8rem; }
</style>
