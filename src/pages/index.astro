---
// Blog-Übersicht (https://heimvio.de/blog/): alle Posts, neueste zuerst.
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Heimvio Blog — Nebenkosten, Heizkosten & Anlage V für Kleinvermieter</title>
    <meta name="description" content="Praxisnahe Artikel für Kleinvermieter: Nebenkostenabrechnung, Heizkostenabrechnung, Anlage V und Messdienstleister — verständlich erklärt." />
    <link rel="canonical" href="https://heimvio.de/blog/" />
    <link rel="alternate" type="application/rss+xml" title="Heimvio Blog" href="/blog/rss.xml" />
  </head>
  <body>
    <main>
      <h1>Heimvio Blog</h1>
      <p class="lead">
        Nebenkostenabrechnung, Heizkosten und Anlage V — praxisnah erklärt für private Vermieter.
      </p>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.data.slug ?? p.id}`}>
              <h2>{p.data.title}</h2>
              <p class="desc">{p.data.description}</p>
              <time datetime={p.data.date.toISOString().slice(0, 10)}>
                {p.data.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <footer class="site">
      <p><a href="/blog/rss.xml">RSS</a> · <a href="https://heimvio.de/">heimvio.de</a> ·
        <a href="https://heimvio.de/impressum">Impressum</a> · <a href="https://heimvio.de/datenschutz">Datenschutz</a></p>
    </footer>
  </body>
</html>

<style>
  :root { --fg: #1c2733; --muted: #5b6b7b; --border: #dde4ea; --accent: #1976d2; --bg: #fff; --surface: #f5f7f9; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e4e9ee; --muted: #93a3b3; --border: #2e3b47; --accent: #64a9e8; --bg: #10161c; --surface: #1a222b; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 44rem; margin: 0 auto; padding: 2rem 1.25rem; }
  footer.site { max-width: 44rem; margin: 0 auto; padding: 1rem 1.25rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .9rem; }
  .lead { color: var(--muted); }
  .posts { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .posts a { display: block; color: inherit; text-decoration: none; background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; transition: border-color .15s; }
  .posts a:hover { border-color: var(--accent); }
  .posts h2 { margin: 0 0 .25rem; font-size: 1.2rem; color: var(--accent); }
  .desc { margin: 0 0 .35rem; }
  time { color: var(--muted); font-size: .85rem; }
  footer a { color: var(--accent); text-decoration: none; }
</style>
