---
// Dynamisches Routing: /doku/<slug> — rendert eine MDX-Doku-Seite im DocPage-Layout.
import { getCollection, render } from 'astro:content';
import DocPage from '../../layouts/DocPage.astro';

export async function getStaticPaths() {
  const pages = await getCollection('doku', ({ data }) => !data.draft);
  return pages.map((page) => ({
    params: { slug: page.data.slug ?? page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const slug = page.data.slug ?? page.id;
---

<DocPage title={page.data.title} description={page.data.description} slug={slug}>
  <Content />
</DocPage>
