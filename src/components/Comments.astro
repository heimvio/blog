---
// Kommentar-Island: statisches HTML enthält KEINE Kommentare (SEO-neutral) —
// sie werden clientseitig von /api/comments/:slug geladen (nur approved).
// Formular: Honeypot-Feld „website" (unsichtbar; Bots füllen es aus → Server
// verwirft still), Server-Rate-Limit 1 Kommentar/IP/Stunde, Claude-Moderation.
interface Props { slug: string }
const { slug } = Astro.props;
---

<section class="comments" aria-label="Kommentare">
  <h2>Kommentare</h2>
  <ul id="comment-list" class="comment-list"></ul>
  <p id="comment-empty" class="muted" hidden>Noch keine Kommentare — schreib den ersten!</p>

  <form id="comment-form" autocomplete="off">
    <label>Name<br /><input name="author_name" required maxlength="80" /></label>
    <label>Kommentar<br /><textarea name="content" required minlength="3" maxlength="4000" rows="4"></textarea></label>
    <!-- Honeypot: für Menschen unsichtbar; ausgefüllt = Bot. -->
    <label class="hp" aria-hidden="true" tabindex="-1">Website<input name="website" tabindex="-1" /></label>
    <button type="submit">Kommentar absenden</button>
    <p id="comment-status" class="muted" role="status"></p>
  </form>
</section>

<script define:vars={{ slug }}>
  const list = document.getElementById('comment-list');
  const empty = document.getElementById('comment-empty');
  const form = document.getElementById('comment-form');
  const status = document.getElementById('comment-status');

  const esc = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };

  async function load() {
    try {
      const res = await fetch(`/api/comments/${encodeURIComponent(slug)}`);
      if (!res.ok) return;
      const items = await res.json();
      list.innerHTML = items.map((c) => `
        <li>
          <p class="c-head"><strong>${esc(c.author_name)}</strong>
            <time datetime="${c.created_at}">${new Date(c.created_at).toLocaleDateString('de-DE')}</time></p>
          <p class="c-body">${esc(c.content)}</p>
        </li>`).join('');
      empty.hidden = items.length > 0;
    } catch { /* Kommentare sind optional — Seite bleibt nutzbar. */ }
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    status.textContent = 'Wird gesendet …';
    const fd = new FormData(form);
    try {
      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          slug,
          author_name: fd.get('author_name'),
          content: fd.get('content'),
          website: fd.get('website') || '',
        }),
      });
      if (res.status === 429) { status.textContent = 'Bitte warte etwas — maximal ein Kommentar pro Stunde.'; return; }
      if (!res.ok) { status.textContent = 'Senden fehlgeschlagen — bitte später erneut versuchen.'; return; }
      const out = await res.json();
      form.reset();
      status.textContent = out.status === 'approved'
        ? 'Danke! Dein Kommentar ist veröffentlicht.'
        : 'Danke! Dein Kommentar wird geprüft und erscheint nach Freigabe.';
      if (out.status === 'approved') load();
    } catch { status.textContent = 'Senden fehlgeschlagen — bitte später erneut versuchen.'; }
  });

  load();
</script>

<style>
  .comments { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  .comment-list { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .comment-list li { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: .75rem 1rem; }
  .c-head { margin: 0 0 .25rem; font-size: .9rem; display: flex; gap: .75rem; align-items: baseline; }
  .c-head time { color: var(--muted); font-size: .8rem; }
  .c-body { margin: 0; white-space: pre-wrap; }
  form { display: flex; flex-direction: column; gap: .75rem; max-width: 34rem; }
  input, textarea { width: 100%; font: inherit; padding: .5rem .65rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--fg); }
  button { align-self: flex-start; font: inherit; padding: .5rem 1.1rem; border: none; border-radius: 6px; background: var(--accent); color: #fff; cursor: pointer; }
  button:hover { filter: brightness(1.08); }
  .muted { color: var(--muted); font-size: .9rem; }
  /* Honeypot: visuell + für Screenreader raus, aber im DOM ausfüllbar. */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>
