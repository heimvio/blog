---
// Kopf der Site: heimvio-Logo (Absprung zur Startseite), Doku + Blog als
// Geschwister, rechts der Weg in die App. Die aktive Sektion wird unterstrichen.
// Stil in public/site/v1/site.css. Die Doku (heimvio-Repo, doku/) hat eine Kopie
// dieses Markups — ein neuer Menüpunkt hier wird dort nachgezogen (Plan #119).
interface Props {
  section: 'blog' | 'doku';
}
const { section } = Astro.props;
---

<header class="site-head">
  <a class="brand" href="https://heimvio.de/" aria-label="heimvio — zur Startseite">
    <img src="/logo.svg" alt="heimvio" height="28" />
  </a>
  <a class="nav" class:list={[{ active: section === 'doku' }]} href="/doku/">Doku</a>
  <a class="nav" class:list={[{ active: section === 'blog' }]} href="/blog/">Blog</a>
  <span class="spacer"></span>
  <a class="to-app" href="https://heimvio.de/">heimvio.de →</a>
</header>
