---
// Preistabelle der Abos (Plan 82 S9). Quelle ist src/data/preise.json — die
// Datei schreibt die Stripe-Provisionierung von heimvio beim Live-Lauf
// (scripts/stripe-provision.mjs --profil=live --apply) aus demselben Katalog,
// aus dem Stripe und der Checkout der App ihre Preise haben. Fehlt die Datei,
// zeigt die Komponente nichts: vor dem Live-Gang stehen keine Preise in der Doku.
interface Staffel {
  wohneinheiten: number;
  monatlich: number;
  messdienst: number;
  hausverwaltung: number;
}
interface Preise {
  steuer: string;
  abrechnung: string;
  staffeln: Staffel[];
}
const files = import.meta.glob<{ default: Preise }>('../data/preise.json', { eager: true });
const preise = Object.values(files)[0]?.default ?? null;
const eur = (cent: number) =>
  (cent / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
---
{preise && (
  <section>
    <h2 id="tarife-und-preise">Tarife und Preise</h2>
    <p>
      Messdienst und Hausverwaltung buchen Sie einzeln oder zusammen.
      Abgerechnet wird {preise.abrechnung}. Alle Preise {preise.steuer}.
    </p>
    <table>
      <thead>
        <tr>
          <th>Tarif</th>
          <th>Wohneinheiten</th>
          <th>nur Messdienst</th>
          <th>nur Hausverwaltung</th>
          <th>beides</th>
        </tr>
      </thead>
      <tbody>
        {preise.staffeln.map((s) => (
          <tr>
            <td>Pro {s.wohneinheiten}</td>
            <td>bis {s.wohneinheiten}</td>
            <td>{eur(s.messdienst)}</td>
            <td>{eur(s.hausverwaltung)}</td>
            <td>{eur(s.monatlich)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      Zum Messdienst gehört ein Funkempfänger je sechs Wohneinheiten, als Leihgabe; ohne
      Messdienst gibt es keine Geräte. Der Messdienst ist als Heiz- und Wasserkostenerfassung
      umlagefähig, die Hausverwaltung nicht. Für größere Gemeinschaften machen wir ein Angebot.
    </p>
  </section>
)}
