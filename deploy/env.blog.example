# Vorlage für /etc/heimvio-blog/.env.blog auf heimvio.de (chmod 640, root:act-runner).
# NICHT ins Repo committen — nur diese Vorlage.

# Eigene blog-Datenbank (Role + DB einmalig im Prod-Postgres anlegen):
#   CREATE ROLE blog LOGIN PASSWORD '<pw>'; CREATE DATABASE blog OWNER blog;
DATABASE_URL=postgres://blog:<pw>@postgres:5432/blog

# Claude-Moderation (Wert aus /opt/heimvio/ops/deploy/.env.prod übernehmen).
ANTHROPIC_API_KEY=

# Review-Benachrichtigung (SMTP-Werte aus .env.prod übernehmen).
HEIMVIO_NOTIFY_SMTP_HOST=
HEIMVIO_NOTIFY_SMTP_PORT=587
HEIMVIO_NOTIFY_SMTP_USER=
HEIMVIO_NOTIFY_SMTP_PASSWORD=
HEIMVIO_NOTIFY_SMTP_FROM=
BLOG_NOTIFY_TO=

# Admin-UI: Zitadel-App "blog-admin" (Web/PKCE, public, Redirect https://heimvio.de/admin/).
BLOG_ADMIN_CLIENT_ID=
# Komma-getrennte Zitadel-User-IDs (sub), die administrieren dürfen.
BLOG_ADMIN_SUBJECTS=

# Zufälliges Secret für IP-HMAC (Rate-Limit ohne Klartext-IPs), z. B.: openssl rand -hex 32
COMMENT_IP_HASH_SECRET=
